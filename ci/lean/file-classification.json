      "prefixes": [
        "crates/native/docs/",
        "crates/services/attachment/docs/",
        "crates/services/information/docs/",
        "crates/services/speech/docs/",
        "docs/",
        "products/fte/docs/",
        "products/loom/docs/",
        "products/mom/docs/"
