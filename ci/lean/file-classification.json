{
  "schema_version": 1,
  "path_universe": "git ls-files --cached",
  "match_semantics": "Rules are evaluated in array order; the first matching exact path, prefix, or suffix assigns the class. A rule may use more than one matcher and matches when any matcher matches. No catch-all rule is permitted.",
  "classes": [
    "shipping production",
    "optional product feature",
    "research",
    "diagnostic",
    "test",
    "fixture",
    "generated",
    "migration-only",
    "legacy compatibility",
    "documentation",
    "tooling",
    "unused"
  ],
  "rules": [
    {
      "class": "generated",
      "prefixes": [
        "crates/services/information/crates/tauri-plugin-information-native/permissions/autogenerated/",
        "crates/services/information/crates/tauri-plugin-information-native/permissions/schemas/",
        "crates/services/speech/crates/tauri-plugin-speech-native/permissions/autogenerated/",
        "crates/services/speech/crates/tauri-plugin-speech-native/permissions/schemas/",
        "products/fte/crates/tauri-plugin-free-token-energy/permissions/autogenerated/",
        "products/fte/crates/tauri-plugin-free-token-energy/permissions/schemas/",
        "products/loom/apps/loom/src-tauri/gen/",
        "products/loom/crates/tauri-plugin-loom/permissions/autogenerated/",
        "products/loom/crates/tauri-plugin-loom/permissions/schemas/"
      ]
    },
    {
      "class": "fixture",
      "prefixes": [
        "crates/native/fixtures/",
        "crates/platform/contracts/fixtures/",
        "crates/platform/contracts/verticals/",
        "crates/services/information/crates/information-native-catalog/tests/fixtures/",
        "crates/services/information/tests/fixtures/",
        "crates/services/speech/fixtures/",
        "products/fte/tests/fixtures/",
        "products/loom/crates/loom-store/tests/fixtures/",
        "products/loom/fixtures/",
        "products/mom/crates/mom-llama-runtime/fixtures/",
        "products/mom/scripts/fixtures/"
      ]
    },
    {
      "class": "migration-only",
      "prefixes": [
        "docs/migration/",
        "migration/",
        "products/loom/docs/reconciliation/",
        "tests/vertical/"
      ],
      "exact": [
        "products/fte/native-pins.env",
        "products/fte/tests/support/w1_source_tree.rs",
        "products/fte/w1-contracts.env",
        "scripts/check-contract-import-history.sh",
        "scripts/check-loom-import-history.sh",
        "scripts/check-mom-import-history.sh",
        "scripts/check-native-import-history.sh",
        "scripts/check-service-import-history.sh"
      ]
    },
    {
      "class": "unused",
      "prefixes": [
        "crates/native/crates/command-evidence/"
      ]
    },
    {
      "class": "legacy compatibility",
      "prefixes": [
        "products/mom/contracts/"
      ],
      "exact": [
        "crates/native/crates/llama-native-engine/src/operation_registry/w1_contract_adapter.rs",
        "crates/native/crates/llama-native-engine/src/w1_vertical_fixture.rs",
        "crates/services/information/crates/information-native-acquire/src/w1_contract.rs",
        "crates/services/speech/crates/speech-native-host/src/w1_contracts.rs",
        "crates/services/speech/crates/speech-native-host/src/w1_lifecycle_tests.rs",
        "products/fte/crates/fte-router/src/w1_contract_tests.rs",
        "products/fte/src-tauri/src/w1_quit_relaunch_tests.rs",
        "products/loom/crates/loom-host/src/w1_contract_adapter.rs",
        "products/loom/crates/tauri-plugin-loom/src/w1_contract_adapter.rs",
        "products/loom/crates/tauri-plugin-loom/src/w1_vertical_fixture.rs",
