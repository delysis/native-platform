      "suffixes": [
        ".md",
        "LICENSE",
        "LICENSE-APACHE",
        "LICENSE-MIT"
      ],
      "exact": [
        "products/mom/apps/mom-llama/ui/LUCIDE-LICENSE.txt"
      ]
    },
    {
      "class": "tooling",
      "prefixes": [
        ".cargo/",
        ".github/",
        "ci/",
        "crates/native/scripts/",
        "crates/services/attachment/scripts/",
        "crates/services/information/scripts/",
        "crates/services/speech/scripts/",
        "products/fte/scripts/",
        "products/mom/scripts/",
        "scripts/",
        "xtask/"
      ],
      "suffixes": [
        ".gitattributes",
        ".gitignore",
        "Cargo.lock",
        "Cargo.toml",
        "build.rs",
        "package.json",
        "rust-toolchain.toml",
        "rustfmt.toml"
      ],
      "exact": [
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "products/loom/.gitleaks.toml",
        "products/loom/apps/loom/tsconfig.json"
      ]
    },
    {
      "class": "test",
      "prefixes": [
        "crates/platform/contracts/crates/platform-contract-testkit/",
        "crates/platform/contracts/crates/platform-contracts-v0/tests/",
        "crates/platform/contracts/crates/platform-vertical-fixtures-v0/",
        "crates/services/attachment/crates/attachment-native-cli/tests/",
        "crates/services/attachment/crates/attachment-native-inspect/tests/",
        "crates/services/attachment/fuzz/",
