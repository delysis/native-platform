        "products/loom/apps/loom/tests/",
        "products/loom/crates/loom-backend-llama/tests/",
        "products/loom/crates/loom-eval/tests/",
        "products/loom/crates/loom-inference/tests/",
        "products/loom/crates/loom-store/tests/",
        "products/mom/crates/mom-llama-cli/tests/",
        "products/mom/crates/mom-llama-runtime/tests/"
      ],
      "suffixes": [
        ".test.mjs",
        ".test.ts",
        "_tests.rs",
        "tests.rs"
      ]
    },
    {
      "class": "research",
      "prefixes": [
        "products/fte/research/",
        "products/loom/crates/loom-benchmark/",
        "products/loom/crates/loom-campaign/",
        "products/loom/crates/loom-context/",
        "products/loom/crates/loom-eval-codex/",
        "products/loom/crates/loom-eval/",
        "products/loom/crates/loom-learning/",
        "products/loom/crates/loom-research-types/",
        "products/loom/crates/loom-search/",
        "products/loom/crates/loom-trial/"
      ],
      "exact": [
        "products/loom/crates/loom-store/src/research_admission.rs",
        "products/loom/crates/loom-store/src/research_archive.rs",
        "products/loom/crates/loom-store/src/research_benchmark.rs",
        "products/loom/crates/loom-store/src/research_campaign_authority.rs",
        "products/loom/crates/loom-store/src/research_evaluation.rs",
        "products/loom/crates/loom-store/src/research_execution.rs",
        "products/loom/crates/loom-store/src/research_journal.rs",
        "products/loom/crates/loom-store/src/research_prompt_evidence.rs",
        "products/loom/crates/loom-store/src/research_session.rs",
        "products/loom/crates/loom-store/src/research_story.rs"
      ]
    },
    {
      "class": "optional product feature",
      "prefixes": [
        "crates/services/attachment/crates/attachment-native-cli/",
        "crates/services/information/crates/information-native-backend-community/",
        "crates/services/information/crates/information-native-backend-encyclopedia/",
        "crates/services/information/crates/information-native-backend-scripture/",
        "crates/services/information/crates/information-native-cli/",
