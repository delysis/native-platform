    {
      "class": "diagnostic",
      "prefixes": [
        "crates/native/docs/audit-receipts/",
        "crates/services/attachment/docs/audit-receipts/",
        "crates/services/information/docs/audit-receipts/",
        "crates/services/speech/docs/audit-receipts/",
        "products/fte/docs/audit-receipts/",
        "products/fte/receipts/",
        "products/loom/docs/audit-receipts/",
        "products/mom/docs/audit-receipts/",
        "products/mom/receipts/"
      ],
      "exact": [
        "docs/architecture/adr/SHA256SUMS.json"
