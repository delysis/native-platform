+struct AdmittedEvents {
+	inner:  Option<RawEventStream>,
+	permit: Option<AdmissionPermit>,
+}
+impl Stream for AdmittedEvents {
+	type Item = Result<RawEvent, Error>;
+
+	fn poll_next(mut self: pin::Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Option<Self::Item>> {
+		let Some(inner) = self.inner.as_mut() else {
+			return Poll::Ready(None);
+		};
+		let mut item = inner.as_mut().poll_next(cx);
+		match &mut item {
+			Poll::Ready(Some(Ok(RawEvent::Answer(body)))) if has_live_body(body) => {
+				if let Some(permit) = self.permit.take() {
+					body.retain_guard(permit);
+				}
+			},
+			Poll::Ready(None | Some(Err(_) | Ok(RawEvent::Failure(_)))) => {
+				self.inner = None;
+				self.permit.take();
+			},
+			Poll::Ready(Some(Ok(
+				RawEvent::ImageGeneration(GenerationEvent::Completed(_))
+				| RawEvent::VideoGeneration(GenerationEvent::Completed(_))
+				| RawEvent::Transcript(TranscriptEvent::Completed { .. }),
+			))) => {
+				self.inner = None;
+				self.permit.take();
+			},
+			Poll::Ready(Some(Ok(RawEvent::Audio(chunk)))) if chunk.final_chunk => {
+				self.inner = None;
+				self.permit.take();
+			},
+			_ => {},
+		}
+		// RawCompletion is not EOF: recovery still drains provider metadata and
+		// usage before publishing the canonical terminal completion.
+		item
+	}
+}
+
+fn has_live_body(body: &AnswerBody) -> bool {
+	matches!(
+		body,
+		AnswerBody::Chat(_)
+			| AnswerBody::Images(_)
+			| AnswerBody::Video(_)
+			| AnswerBody::Speech(_)
+			| AnswerBody::Transcript(_)
+			| AnswerBody::Realtime(_)
+			| AnswerBody::Native(crate::answer::NativeResponse {
+				body: NativeResponseBody::Stream(_),
+				..
+			})
+	)
+}
