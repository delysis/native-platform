+/// Both successful and rejected HTTP responses must hand their effective
+/// decoded byte ceiling to the decompressor, before parsing or classification.
+#[tokio::test]
+async fn compressed_response_bombs_respect_success_and_error_body_limits() {
+	use std::io::Write as _;
+	let payload = vec![b'x'; 8 * 1024 * 1024];
+	for encoding in ["gzip", "deflate", "br", "zstd"] {
+		let wire = match encoding {
+			"gzip" => {
+				let mut writer =
+					flate2::write::GzEncoder::new(Vec::new(), flate2::Compression::default());
+				writer.write_all(&payload).unwrap();
+				writer.finish().unwrap()
+			},
+			"deflate" => {
+				let mut writer =
+					flate2::write::ZlibEncoder::new(Vec::new(), flate2::Compression::default());
+				writer.write_all(&payload).unwrap();
+				writer.finish().unwrap()
+			},
+			"br" => {
+				let mut writer = brotli::CompressorWriter::new(Vec::new(), 4096, 5, 22);
+				writer.write_all(&payload).unwrap();
+				writer.into_inner()
+			},
+			"zstd" => zstd::encode_all(payload.as_slice(), 3).unwrap(),
+			_ => unreachable!(),
+		};
+		for (status, limit) in [(200, 65_536), (429, payload.len() as u64), (400, 1024)] {
+			let listener = TcpListener::bind("127.0.0.1:0")
+				.await
+				.expect("fixture listener");
+			let address = listener.local_addr().unwrap();
+			let wire = wire.clone();
+			let server = tokio::spawn(async move {
+				let (mut socket, _) = listener.accept().await.unwrap();
+				let mut request = [0; 4096];
+				let _ = socket.read(&mut request).await.unwrap();
+				let headers = format!(
+					"HTTP/1.1 {status} Response\r\ncontent-encoding: {encoding}\r\ncontent-length: \
+					 {}\r\n\r\n",
+					wire.len()
+				);
+				socket.write_all(headers.as_bytes()).await.unwrap();
+				socket.write_all(&wire).await.unwrap();
+				socket.shutdown().await.unwrap();
+			});
+			let mut service = HttpTransport::new();
+			service.ready().await.unwrap();
+			let mut call = request(
+				BodySource::Bytes(Bytes::from_static(b"request")),
+				EmitDecoder,
+				Cancellation::default(),
+			);
+			call.encoded.uri = sf!("http://{address}/stream");
+			call.encoded.bounds.response = limit;
+			call.encoded.bounds.frame = payload.len() as u64;
+			let error = time::timeout(time::Duration::from_secs(5), service.call(call))
+				.await
+				.expect("bounded response deadline")
+				.err()
+				.expect("body limit failure");
+			assert_eq!(error.kind, ErrorKind::Protocol, "{encoding}/{status}");
+			assert_eq!(error.status, Some(status));
+			assert_eq!(error.phase, ErrorPhase::Handshake);
+			assert_eq!(error.action, RetryAction::Never);
+			assert!(!error.committed);
+			assert!(
+				matches!(error.detail_ref(), Some(ErrorDetail::Protocol { reason }) if reason.0.as_str() == "response-body-limit"),
+				"{error:?}"
+			);
+			server.await.unwrap();
+		}
+	}
+}
