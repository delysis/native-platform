+#[tokio::test]
+async fn compressed_response_limit_remains_cumulative_after_visible_output() {
+	use std::io::Write as _;
+	let mut writer = flate2::write::GzEncoder::new(Vec::new(), flate2::Compression::default());
+	writer.write_all(b"data: first\n\n").unwrap();
+	writer.flush().unwrap();
+	let prefix = std::mem::take(writer.get_mut());
+	writer.write_all(&vec![b'x'; 128 * 1024]).unwrap();
+	let suffix = writer.finish().unwrap();
+	let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+	let address = listener.local_addr().unwrap();
+	let (visible_tx, visible_rx) = oneshot::channel();
+	let server = tokio::spawn(async move {
+		let (mut socket, _) = listener.accept().await.unwrap();
+		let mut request = [0; 4096];
+		let _ = socket.read(&mut request).await.unwrap();
+		let headers = format!(
+			"HTTP/1.1 200 OK\r\ncontent-encoding: gzip\r\ncontent-length: {}\r\n\r\n",
+			prefix.len() + suffix.len()
+		);
+		socket.write_all(headers.as_bytes()).await.unwrap();
+		socket.write_all(&prefix).await.unwrap();
+		time::timeout(time::Duration::from_secs(5), visible_rx)
+			.await
+			.unwrap()
+			.unwrap();
+		socket.write_all(&suffix).await.unwrap();
+		socket.shutdown().await.unwrap();
+	});
+	let mut service = HttpTransport::new();
+	service.ready().await.unwrap();
+	let mut call = request(
+		BodySource::Bytes(Bytes::from_static(b"request")),
+		CapturedSseDecoder,
+		Cancellation::default(),
+	);
+	call.encoded.uri = sf!("http://{address}/stream");
+	call.encoded.framing = FramingProtocol::Sse;
+	call.encoded.bounds.response = 64 * 1024;
+	let response = time::timeout(time::Duration::from_secs(5), service.call(call))
+		.await
+		.unwrap()
+		.unwrap();
+	let mut events = response.events.unwrap();
+	let first = events.next().await.unwrap().unwrap();
+	assert!(
+		matches!(first, RawEvent::Chat(ChatEvent::TextDelta { text, .. }) if text.as_str() == "first")
+	);
+	visible_tx.send(()).unwrap();
+	let error = time::timeout(time::Duration::from_secs(5), events.next())
+		.await
+		.unwrap()
+		.unwrap()
+		.err()
+		.expect("stream body limit");
+	assert_eq!(error.phase, ErrorPhase::Streaming);
+	assert!(error.committed);
+	assert_eq!(error.action, RetryAction::Never);
+	assert!(
+		matches!(error.detail_ref(), Some(ErrorDetail::Protocol { reason }) if reason.0.as_str() == "response-body-limit")
+	);
+	assert!(events.next().await.is_none());
+	server.await.unwrap();
+}
