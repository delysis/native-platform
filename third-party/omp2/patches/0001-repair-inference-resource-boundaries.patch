 /// Owned asynchronous stream of fallible values.
 pub type OutputStream<T> = Pin<Box<dyn Stream<Item = Result<T, Error>> + Send + 'static>>;
 
+/// Internal ownership transferred from a handshake into its live response.
+/// Accounting guards settle in `Drop`; successful terminal observations are
+/// distinct from cancellation, failure, or an abandoned response.
+pub(crate) trait ResponseGuard: Send + 'static {
+	fn complete(&mut self) {}
+	fn receipt(&mut self, _receipt: &ExecutionReceipt) {}
+	fn usage(&mut self, _usage: Usage, _cost: Cost) {}
+	fn response(&mut self, completion: &crate::event::Completion) {
+		self.receipt(&completion.receipt);
+		self.usage(completion.usage, completion.receipt.cost);
+	}
+}
+
+pin_project_lite::pin_project! {
+	struct GuardedStream<T, G> {
+		inner: Option<OutputStream<T>>,
+		guard: Option<G>,
+		observe: fn(&T, &mut G) -> bool,
+		eof_complete: bool,
+	}
+}
+
+impl<T, G: ResponseGuard> Stream for GuardedStream<T, G> {
+	type Item = Result<T, Error>;
+
+	fn poll_next(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Option<Self::Item>> {
+		let this = self.project();
+		let Some(inner) = this.inner.as_mut() else {
+			return Poll::Ready(None);
+		};
+		let item = inner.as_mut().poll_next(cx);
+		let Some(guard) = this.guard.as_mut() else {
+			return item;
+		};
+		match &item {
+			Poll::Ready(Some(Ok(event))) => {
+				if (this.observe)(event, guard) {
+					guard.complete();
+					this.inner.take();
+					this.guard.take();
+				}
+			},
+			Poll::Ready(Some(Err(error))) => {
+				guard.receipt(error.receipt());
+				this.inner.take();
+				this.guard.take();
+			},
+			Poll::Ready(None) => {
+				if *this.eof_complete {
+					guard.complete();
+				}
+				this.inner.take();
+				this.guard.take();
+			},
+			Poll::Pending => {},
+		}
+		item
+	}
+}
+
+fn retain_stream_guard<T: Send + 'static, G: ResponseGuard>(
+	stream: &mut OutputStream<T>,
+	guard: G,
+	observe: fn(&T, &mut G) -> bool,
+	eof_complete: bool,
+) {
+	// Stream erasure already exists at this I/O ownership boundary. One wrapper
+	// allocation per response never adds allocation to frame/token polling.
+	let inner = std::mem::replace(stream, Box::pin(futures::stream::empty()));
+	*stream =
+		Box::pin(GuardedStream { inner: Some(inner), guard: Some(guard), observe, eof_complete });
+}
+
+fn observe_generation<T, G: ResponseGuard>(event: &GenerationEvent<T>, guard: &mut G) -> bool {
+	if let GenerationEvent::Completed(summary) = event {
+		guard.usage(summary.usage, summary.cost);
+		true
+	} else {
+		false
+	}
+}
