; Native port of products/loom/apps/loom/src/App.svelte and app.css.
; The original interface is the specification. Do not invent replacement chrome.
; Icons are extracted from the original title-bar SVGs by build.rs.
; Input 24: active formatting mask. Inputs 46/47: Link/Remove enabled.
; Input 21: measured Iowan "0" advance; 22: format menu; 23: native fullscreen.
@external
(var input: [48: f32] (zeroed-array))
(defn chrome-focus []: bool (or (> (input 43u) 0.) (> (input 44u) 0.)))
(defn dark []: bool (> (input 19u) 0.))
(defn paper []: vec4f (if (dark) (vec4f (/ 41. 255.) (/ 43. 255.) (/ 39. 255.) 1.) (vec4f (/ 251. 255.) (/ 249. 255.) (/ 244. 255.) 1.)))
(defn wash []: vec4f (if (dark) (vec4f (/ 34. 255.) (/ 36. 255.) (/ 32. 255.) 1.) (vec4f (/ 244. 255.) (/ 240. 255.) (/ 232. 255.) 1.)))
(defn chrome []: vec4f (if (dark) (vec4f (/ 45. 255.) (/ 46. 255.) (/ 45. 255.) 1.) (vec4f (/ 236. 255.) (/ 235. 255.) (/ 234. 255.) 1.)))
(defn outline-paper []: vec4f (if (dark) (vec4f (/ 38. 255.) (/ 39. 255.) (/ 38. 255.) 1.) (vec4f (/ 241. 255.) (/ 240. 255.) (/ 238. 255.) 1.)))
(defn line []: vec4f (if (dark) (vec4f (/ 69. 255.) (/ 71. 255.) (/ 65. 255.) 1.) (vec4f (/ 220. 255.) (/ 214. 255.) (/ 202. 255.) 1.)))
(defn soft-line []: vec4f (if (dark) (vec4f (/ 59. 255.) (/ 61. 255.) (/ 56. 255.) 1.) (vec4f (/ 232. 255.) (/ 227. 255.) (/ 218. 255.) 1.)))
; For labels, w selects a font role; for vector paint it is opacity.
(defn ink [kind: f32]: vec4f (if (dark) (vec4f (/ 231. 255.) (/ 229. 255.) (/ 223. 255.) kind) (vec4f (/ 41. 255.) (/ 43. 255.) (/ 41. 255.) kind)))
(defn muted [kind: f32]: vec4f (if (dark) (vec4f (/ 176. 255.) (/ 175. 255.) (/ 168. 255.) kind) (vec4f (/ 116. 255.) (/ 116. 255.) (/ 110. 255.) kind)))
(defn moss []: vec4f (if (dark) (vec4f (/ 145. 255.) (/ 177. 255.) (/ 154. 255.) 0.) (vec4f (/ 82. 255.) (/ 109. 255.) (/ 91. 255.) 0.)))
(defn hover []: vec4f (if (dark) (vec4f (/ 58. 255.) (/ 59. 255.) (/ 58. 255.) 1.) (vec4f (/ 222. 255.) (/ 221. 255.) (/ 219. 255.) 1.)))
(defn selection []: vec4f (if (dark) (vec4f (/ 83. 255.) (/ 106. 255.) (/ 89. 255.) 1.) (vec4f (/ 203. 255.) (/ 217. 255.) (/ 205. 255.) 1.)))
(defn rect [box: vec4f color: vec4f] (print "rect") (print box) (print color))
(defn round [box: vec4f color: vec4f radius: f32] (print "round") (print box) (print color) (print (vec4f radius 0. 0. 0.)))
(defn label [box: vec4f color: vec4f] (print "text") (print box) (print color))
(defn slot [box: vec4f color: vec4f identity: f32] (print "slot") (print box) (print color) (print (vec4f identity 0. 0. 0.)))
(defn editor [box: vec4f font-size: f32 leading: f32 identity: f32 focus: f32]
  (print "editor") (print box) (print (vec4f font-size leading identity (if (chrome-focus) 0. focus))) (print (ink 1.)))
(defn action [kind: f32 argument: f32] (print "action") (print (vec4f kind argument 0. 0.)))
(defn inside [box: vec4f]: bool (and (and (>= (input 3u) box.x) (< (input 3u) (+ box.x box.z))) (and (>= (input 4u) box.y) (< (input 4u) (+ box.y box.w)))))
(defn clicked [box: vec4f]: bool (and (== (input 2u) 1.) (inside box)))
; control must be followed by the original accessible label; it paints no text.
(defn focus-ring [box: vec4f identity: f32]
  (when (and (== (input 44u) identity) (> (input 45u) 0.))
    (let [c (moss) color (vec4f c.x c.y c.z 0.72)]
      (rect (vec4f (- box.x 5.) (- box.y 5.) (+ box.z 10.) 3.) color)
      (rect (vec4f (- box.x 5.) (+ (+ box.y box.w) 2.) (+ box.z 10.) 3.) color)
      (rect (vec4f (- box.x 5.) (- box.y 2.) 3. (+ box.w 4.)) color)
      (rect (vec4f (+ (+ box.x box.z) 2.) (- box.y 2.) 3. (+ box.w 4.)) color))))
(defn control [box: vec4f enabled: f32 identity: f32]
  (focus-ring box identity)
  (print "control") (print box) (print (vec4f enabled 0. identity 0.)))
(defn icon [box: vec4f identity: f32 stroke: f32 filled: f32 opacity: f32]
  (print "icon") (print (vec4f (+ box.x (* 0.5 (- box.z 15.))) (+ box.y 4.5) 15. 15.))
  (print (if (inside box) (ink opacity) (muted opacity))) (print (vec4f identity stroke filled 0.)))
(defn button [box: vec4f command: f32 argument: f32 enabled: f32]
  (when (> enabled 0.)
    (when (inside box) (round box (hover) 6.))
    (when (and (> command 0.) (clicked box)) (action command argument))))
; app.css: --paper-deep = color-mix(in srgb, --paper 95%, --ink).
(defn format-fill []: vec4f (+ (* (paper) 0.95) (* (ink 1.) 0.05)))
(defn format-button [box: vec4f format: f32]
  (let [active (!= (& (u32 (input 24u)) (<< 1u (u32 format))) 0u)]
    (when (or active (inside box)) (round box (format-fill) 6.))
    (when (clicked box) (action 12. format))
    (focus-ring box (+ 300. format))
    (print "control") (print box) (print (vec4f 1. (if active 1. 0.) (+ 300. format) 1.))
    (if (== format 0.) (print "Body")
      (if (== format 1.) (print "Title")
        (if (== format 2.) (print "Heading")
          (if (== format 3.) (print "Subheading")
            (if (== format 4.) (print "Bold")
              (if (== format 5.) (print "Italic")
                (if (== format 6.) (print "Block quote")
                  (if (== format 7.) (print "Bulleted list") (print "Numbered list"))))))))))
  (if (< format 4.)
    (label (vec4f (+ box.x 8.) (+ box.y 7.) (- box.z 16.) 11.) (ink 0.))
    (styled-label box (ink 1.) (if (== format 4.) 32. (if (== format 5.) 33. 31.)) 1.)))
(defn styled-label [box: vec4f color: vec4f role: f32 centered: f32]
  (print "styled-text") (print box) (print color) (print (vec4f role centered 0. 0.)))
(defn sans-role [identity: f32 size: f32 weight: f32 italic: f32]
  (print "typography") (print (vec4f identity size (* size 1.35) weight))
  (print (vec4f 0. 0. italic 0.))
  (print "Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif")
  (print "'kern' 1, 'liga' 1") (print ""))
(defn link-button [box: vec4f enabled: f32 identity: f32 argument: f32]
  (when (> enabled 0.)
    (when (inside box) (round box (format-fill) 6.))
    (when (clicked box) (action 12. argument)))
  (control box enabled identity)
  (if (== argument 9.) (print "Link") (print "Remove"))
  (styled-label box (ink (if (> enabled 0.) 1. 0.4)) 30. 1.)
  (if (== argument 9.) (print "Link") (print "Remove")))
(defn serif-role [identity: f32 size: f32 leading: f32 weight: f32 italic: f32 underline: f32]
  (print "typography") (print (vec4f identity size leading weight))
  (print (vec4f 0. 0. italic underline))
  (print "Iowan Old Style, Palatino, Georgia, serif")
  (print "'kern' 1, 'liga' 1, 'clig' 1, 'calt' 1") (print ""))
(defn code-role [identity: f32 size: f32 leading: f32]
  (print "typography") (print (vec4f identity size leading 400.))
  (print (vec4f 0. 0. 0. 0.))
  (print "Menlo, Consolas, monospace")
  (print "'kern' 1") (print ""))
(defn paragraph-role [identity: f32 left: f32 right: f32 before: f32 after: f32]
  (print "paragraph") (print (vec4f identity left right 0.))
  (print (vec4f before after 0. 0.)))

; The host captures drags and keyboard focus; the view owns the limits and paint.
(defn divider [box: vec4f identity: f32 size: f32 minimum: f32 maximum: f32 enabled: f32]
  (print "divider") (print box)
  (print (vec4f identity size minimum maximum)) (print (vec4f enabled 0. 0. 0.))
  (when (> enabled 0.)
    (when (or (inside box) (== (input 43u) identity))
      (let [color (moss)] (rect box (vec4f color.x color.y color.z 0.35))))
    (when (clicked box) (action 22. identity))))

; Configured panes use native string slots; authored text never enters this VM.
(defn named-control [box: vec4f enabled: f32 identity: f32]
  (focus-ring box identity)
  (print "control-slot") (print box) (print (vec4f enabled identity identity 0.)))
(defn pane-content [panel: vec4f pane-position: f32 binding: f32 field: f32 focus: f32 enabled: f32 blocked: bool]
  (let [header (vec4f panel.x panel.y panel.z 30.)
        content (vec4f (+ panel.x 12.) (+ panel.y 42.) (max 1. (- panel.z 24.)) (max 1. (- panel.w 42.)))
        available (if blocked 0. enabled)]
    (rect panel (paper))
    (when (> (input (+ 33u (u32 pane-position))) 1.)
      (button header 18. pane-position available)
      (named-control header enabled (+ 200. pane-position))
      (icon (vec4f (- (+ header.x header.z) 24.) (+ header.y 3.) 24. 24.) 7. 1.45 0. 1.))
    (slot (vec4f (+ header.x 8.) (+ header.y 9.) (max 1. (- header.z 36.)) 11.) (muted 0.) (+ 200. pane-position))
    (if (== binding 1.)
      (editor content 19. 32.68 field focus)
      (if (== binding 2.)
        (let [open (vec4f (+ panel.x 8.) (+ panel.y 34.) (max 1. (- panel.z 16.)) 30.)]
          (button open 20. pane-position available)
          (named-control open enabled (+ 220. pane-position))
          (slot (vec4f (+ open.x 8.) (+ open.y 8.) (max 1. (- open.z 16.)) 12.) (ink 0.) (+ 220. pane-position)))
        (slot (vec4f content.x content.y content.z 12.) (muted 0.) (+ 230. pane-position))))))

@cpu
(defn main []
  (let [w (input 0u) h (input 1u) event (input 2u) key (input 5u) cmd (> (input 6u) 0.)
        @var side (input 8u) context (input 25u) @var focus (input 10u) text-size 19.
        leading (if (> (input 23u) 0.) 8. 76.)
        side-button (vec4f leading 2.5 24. 24.)
        new-button (vec4f (+ leading 29.) 2.5 24. 24.)
        right (- w 90.)
        main-binding (input 26u) right-binding (input 27u) bottom-binding (input 28u)
        right-present (> right-binding 0.) bottom-present (> bottom-binding 0.)
        right-visible (and right-present (> (input 29u) 0.))
        bottom-visible (and bottom-present (> (input 30u) 0.))
        right-field (if (> (input 40u) 0.) (input 40u) 3.)
        bottom-field (if (> (input 41u) 0.) (input 41u) 4.)
        enabled (input 38u) pane-menu (input 31u)
        pane-start (- right (* 29. (+ (if right-present 1. 0.) (if bottom-present 1. 0.))))
        right-toggle (vec4f pane-start 2.5 24. 24.)
        bottom-toggle (vec4f (- right 29.) 2.5 24. 24.)
        microphone-box (vec4f right 2.5 24. 24.)
        suggestion-group (vec4f (+ right 29.) 0.5 53. 28.)
        suggestions-box (vec4f (+ right 31.) 2.5 24. 24.)
        loompad-box (vec4f (+ right 56.) 2.5 24. 24.)
        drag-box (vec4f (+ leading 53.) 0. (max 28. (- pane-start (+ leading 53.))) 29.)
        format-box (vec4f right 2.5 0. 0.)
        format-open (and (> (input 22u) 0.) (== (input 16u) 0.))
        popup (vec4f (- (+ right 30.) 280.) 32. 280. 172.)]
    (when (and (clicked side-button) (== pane-menu 0.)) (= side (- 1. side)))
    (when (== event 4.) (action 7. 0.))
    (when (and (== focus 2.) (or (== context 0.) right-visible)) (= focus 0.))
    (when (and (== focus 1.) (> main-binding 1.)) (= focus 0.))
    (when (and (>= focus 3.)
      (not (or (and right-visible (and (== right-binding 1.) (== focus right-field)))
               (and bottom-visible (and (== bottom-binding 1.) (== focus bottom-field)))))) (= focus 0.))
    (when (== focus 0.)
      (if (<= main-binding 1.) (= focus 1.)
        (if (and right-visible (== right-binding 1.)) (= focus right-field)
          (when (and bottom-visible (== bottom-binding 1.)) (= focus bottom-field)))))
    (when (and (== event 2.) (> pane-menu 0.)) (action 21. key))
    (when (and (and (== event 2.) (== pane-menu 0.)) (and (> (input 43u) 0.) (not cmd))) (action 23. key))
    (when (and (and (== event 2.) (== pane-menu 0.)) (or (not (chrome-focus)) cmd))
      (when cmd
        (when (== key 21.) (action 4. 0.))
        (when (== key 22.) (action 5. 0.))
        (when (== key 23.) (action 6. 0.))
        (when (== key 24.) (action 7. 0.))
        (when (and (== key 25.) (and (== (input 7u) 0.) (not (chrome-focus)))) (action 12. 4.))
        (when (and (== key 26.) (not (chrome-focus))) (action 12. 5.))
        (when (and (== key 28.) (> (input 7u) 0.)) (action 11. 0.))
        (when (and (== key 29.) (> (input 7u) 0.)) (action 14. (- 1. (input 22u))))
        (when (and (< key 21.) (not (chrome-focus))) (action 1. focus)))
      (when (not cmd)
        (when (== key 15.) (action 9. 0.))
        (when (!= key 15.) (action 1. focus))))
    (when (and (== event 1.) format-open (not (inside popup)) (not (inside format-box))) (action 14. 0.))
    (let [outline-limit (max 150. (* w 0.35))
          sidebar (if (> side 0.) (min (if (> (input 42u) 0.) (input 42u) 220.) outline-limit) 0.)
          web (> (input 15u) 0.)
          side-present (or right-visible (and (not right-present) (or (> context 0.) web)))
          right-limit (max 180. (- (- w sidebar) 200.))
          bottom-limit (max 100. (* (- h 30.) 0.6))
          pane-width (if side-present (min (if (> (input 36u) 0.) (input 36u) 320.) right-limit) 0.)
          bottom-height (if bottom-visible (min (if (> (input 37u) 0.) (input 37u) 240.) bottom-limit) 0.)
          writing-width (- (- w sidebar) pane-width)
          main-height (- (- h 30.) bottom-height)
          main-panel (vec4f sidebar 30. writing-width main-height)
          right-panel (vec4f (- w pane-width) 30. pane-width main-height)
          right-native (vec4f right-panel.x right-panel.y right-panel.z (if (and web right-visible) (* main-height 0.5) main-height))
          bottom-panel (vec4f sidebar (- h bottom-height) (- w sidebar) bottom-height)
          gutter (max 24. (min 72. (* w 0.05)))
          zero (if (> (input 21u) 0.) (input 21u) 9.5)
          column-width (max 1. (min (* 82. zero) (- writing-width (* 2. gutter))))
          column-x (+ sidebar (* 0.5 (- writing-width column-width)))
          body-top (+ 30. (min 42. (max 24. (* h 0.04))))
          body (if (> main-binding 0.)
            (vec4f (+ sidebar 12.) 72. (max 1. (- writing-width 24.)) (max 1. (- main-height 42.)))
            (vec4f column-x body-top column-width (max 1. (- (- h bottom-height) body-top))))
          notes (vec4f (+ right-panel.x 12.) 42. (max 1. (- pane-width 24.))
            (if web (max 1. (* (- main-height 24.) 0.5)) (max 1. (- main-height 24.))))
          right-body (vec4f (+ right-native.x 12.) 72. (max 1. (- pane-width 24.)) (max 1. (- right-native.w 42.)))
          bottom-body (vec4f (+ sidebar 12.) (+ bottom-panel.y 42.) (max 1. (- bottom-panel.z 24.)) (max 1. (- bottom-height 42.)))
          menu-panel (if (== pane-menu 2.) right-panel (if (== pane-menu 3.) bottom-panel main-panel))
          menu-height (* (input 32u) 30.)
          menu-box (vec4f menu-panel.x (max 30. (min (+ menu-panel.y 30.) (- h menu-height))) (min 280. menu-panel.z) menu-height)
          outline-divider (vec4f (- sidebar 7.) 30. 7. (- h 30.))
          right-divider (vec4f right-panel.x right-panel.y 7. right-panel.w)
          bottom-divider (vec4f bottom-panel.x bottom-panel.y bottom-panel.z 7.)
          overlay (or (> pane-menu 0.) (and format-open (inside popup)))
          divider-hit (or (and (> side 0.) (inside outline-divider))
            (or (and side-present (inside right-divider)) (and bottom-visible (inside bottom-divider))))
          covered (or overlay divider-hit)]
      (when (and (clicked body) (and (<= main-binding 1.) (not covered))) (= focus 1.) (action 2. 1.))
      (when (and right-visible (and (== right-binding 1.) (and (clicked right-body) (not covered)))) (= focus right-field) (action 2. right-field))
      (when (and bottom-visible (and (== bottom-binding 1.) (and (clicked bottom-body) (not covered)))) (= focus bottom-field) (action 2. bottom-field))
      (when (and (not right-present) (and (> context 0.) (and (clicked notes) (not covered)))) (= focus 2.) (action 2. 2.))
      (when (and (== event 3.) (not covered))
        (when (and (inside body) (<= main-binding 1.)) (action 3. 1.))
        (when (and right-visible (and (== right-binding 1.) (inside right-body))) (action 3. right-field))
        (when (and bottom-visible (and (== bottom-binding 1.) (inside bottom-body))) (action 3. bottom-field))
        (when (and (not right-present) (and (> context 0.) (inside notes))) (action 3. 2.)))
      (when (and (and (== event 5.) (not overlay)) (not (chrome-focus))) (action 10. focus))
      (print "typography")
      (print (vec4f 1. text-size (* text-size 1.72) 400.))
      (print (vec4f 0. 0. 0. 0.))
      (print "Iowan Old Style, Palatino, Georgia, serif")
      (print "'kern' 1, 'liga' 1, 'clig' 1, 'calt' 1")
      (print "")
      (print "typography")
      (print (vec4f 2. 15. 25. 400.))
      (print (vec4f 0. 0. 0. 0.))
      (print "Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif")
      (print "'kern' 1, 'liga' 1")
      (print "")
      (serif-role 10. (* text-size 1.9) (* text-size 2.35) 400. 0. 0.)
      (serif-role 11. (* text-size 1.4) (* text-size 1.9) 400. 0. 0.)
      (serif-role 12. (* text-size 1.15) (* text-size 1.7) 600. 0. 0.)
      (serif-role 13. text-size (* text-size 1.72) 600. 0. 0.)
      (serif-role 14. text-size (* text-size 1.72) 600. 1. 0.)
      (serif-role 15. text-size (* text-size 1.72) 400. 1. 0.)
      (code-role 20. (* text-size 0.85) (* text-size 1.5))
      (serif-role 21. text-size (* text-size 1.72) 400. 0. 1.)
      (serif-role 22. text-size (* text-size 1.72) 700. 0. 0.)
      (serif-role 23. text-size (* text-size 1.72) 400. 1. 0.)
      (code-role 24. (* text-size 0.8) (* text-size 1.4))
      (paragraph-role 1. 0. 0. 0. (* text-size 0.8))
      (paragraph-role 10. 0. 0. (* text-size 1.2) (* text-size 0.65))
      (paragraph-role 11. 0. 0. text-size (* text-size 0.5))
      (paragraph-role 12. 0. 0. (* text-size 0.8) (* text-size 0.4))
      (paragraph-role 13. 0. 0. (* text-size 0.8) (* text-size 0.4))
      (paragraph-role 14. 0. 0. (* text-size 0.8) (* text-size 0.4))
      (paragraph-role 15. 0. 0. (* text-size 0.8) (* text-size 0.4))
      (paragraph-role 20. (* text-size 0.5) (* text-size 0.5) (* text-size 0.3) (* text-size 0.8))
      (paragraph-role 30. (* text-size 1.4) 0. 0. (* text-size 0.15))
      (paragraph-role 31. (* text-size 1.2) (* text-size 0.6) 0. 0.)
      (print "selection") (print (selection))
      (rect (vec4f 0. 0. w h) (paper))
      (when (> sidebar 0.)
        (rect (vec4f 0. 30. sidebar (- h 30.)) (outline-paper))
        (rect (vec4f (- sidebar 1.) 30. 1. (- h 30.)) (line))
        (for [i 0u (< i (u32 (min 16. (input 12u)))) (+= i 1u)]
          (let [row (vec4f 8. (+ 84. (* (f32 i) 52.)) (- sidebar 16.) 50.)]
            (when (or (== (f32 i) (input 13u)) (inside row)) (round row (paper) 8.))
            (label (vec4f 17. (+ row.y 10.) 18. 16.) (moss)) (print "¶")
            (slot (vec4f 44. (+ row.y 9.) (- sidebar 92.) 13.) (ink 4.) (+ 100. (f32 i)))
            (named-control row (if overlay 0. enabled) (+ 100. (f32 i)))
            (when (and (clicked row) (not covered)) (action 8. (f32 i))))))
      (if (> main-binding 0.)
        (pane-content main-panel 0. main-binding 1. focus (if overlay 0. enabled) divider-hit)
        (editor body text-size (* text-size 1.72) 1. focus))
      (when side-present
        (rect right-panel (paper))
        (when right-visible (pane-content right-native 1. right-binding right-field focus (if overlay 0. enabled) divider-hit))
        (when (and (not right-present) (> context 0.)) (editor notes 17. 28.05 2. focus))
        (when web
          (let [web-y (if right-visible (+ right-native.y right-native.w)
                         (if (> context 0.) (+ (+ notes.y notes.w) 12.) 30.))]
            (print "webview") (print (vec4f (+ right-panel.x 1.) web-y (max 1. (- pane-width 1.)) (max 1. (- (+ 30. main-height) web-y))))))
        (rect (vec4f right-panel.x 30. 1. main-height) (line)))
      (when bottom-visible
        (pane-content bottom-panel 2. bottom-binding bottom-field focus (if overlay 0. enabled) divider-hit)
        (rect (vec4f sidebar bottom-panel.y (- w sidebar) 1.) (line)))
      (when (> sidebar 0.)
        (divider outline-divider 1. sidebar 150. outline-limit (if overlay 0. enabled)))
      (when side-present
        (divider right-divider 2. pane-width 180. right-limit (if overlay 0. enabled)))
      (when bottom-visible
        (divider bottom-divider 3. bottom-height 100. bottom-limit (if overlay 0. enabled)))
      (rect (vec4f 0. 0. w 30.) (chrome))
      (rect (vec4f 0. 29. w 1.) (soft-line))
      (button side-button 0. 0. 1.)
      (control side-button (if overlay 0. 1.) 1.) (if (> side 0.) (print "Close manuscript outline") (print "Open manuscript outline"))
      (icon side-button 0. 1.45 0. 1.)
      (button new-button 6. 0. (if overlay 0. 1.)) (control new-button (if overlay 0. 1.) 2.) (print "New document")
      (icon new-button 1. 1.45 0. 1.)
      (print "drag") (print drag-box)
      (when (and (clicked drag-box) (not covered)) (action 15. 0.))
      (slot (vec4f drag-box.x 9. drag-box.z 12.) (ink 2.) 0.)
      (when right-present
        (button right-toggle 17. 1. (if overlay 0. enabled))
        (named-control right-toggle (if overlay 0. enabled) 211.) (icon right-toggle 5. 1.45 0. 1.))
      (when bottom-present
        (button bottom-toggle 17. 2. (if overlay 0. enabled))
        (named-control bottom-toggle (if overlay 0. enabled) 212.) (icon bottom-toggle 6. 1.45 0. 1.))
      (control microphone-box 0. 3.) (print "Record audio") (icon microphone-box 2. 1.45 0. 0.45)
      (round suggestion-group (line) 7.)
      (round (vec4f (+ suggestion-group.x 1.) (+ suggestion-group.y 1.) 51. 26.) (chrome) 6.)
      (control suggestions-box 0. 4.) (print "Ghost text") (icon suggestions-box 3. 1.2 1. 0.45)
      (control loompad-box 0. 5.) (print "Loompad") (icon loompad-box 4. 1.45 0. 0.45)
      (when format-open
        (sans-role 30. 11. 400. 0.)
        (sans-role 31. 13. 400. 0.)
        (sans-role 32. 13. 700. 0.)
        (sans-role 33. 13. 400. 1.)
        (round popup (line) 10.)
        (round (vec4f (+ popup.x 1.) (+ popup.y 1.) (- popup.z 2.) (- popup.w 2.)) (paper) 9.)
        (format-button (vec4f (+ popup.x 8.) 40. 130.5 30.) 0.) (print "Body")
        (format-button (vec4f (+ popup.x 141.5) 40. 130.5 30.) 1.) (print "Title")
        (format-button (vec4f (+ popup.x 8.) 73. 130.5 30.) 2.) (print "Heading")
        (format-button (vec4f (+ popup.x 141.5) 73. 130.5 30.) 3.) (print "Subheading")
        (rect (vec4f (+ popup.x 8.) 110. 264. 1.) (soft-line))
        (format-button (vec4f (+ popup.x 8.) 118. 50.4 30.) 4.) (print "B")
        (format-button (vec4f (+ popup.x 61.4) 118. 50.4 30.) 5.) (print "I")
        (format-button (vec4f (+ popup.x 114.8) 118. 50.4 30.) 6.) (print "“”")
        (format-button (vec4f (+ popup.x 168.2) 118. 50.4 30.) 7.) (print "•≡")
        (format-button (vec4f (+ popup.x 221.6) 118. 50.4 30.) 8.) (print "1≡")
        (rect (vec4f (+ popup.x 8.) 155. 264. 1.) (soft-line))
        (let [destination (vec4f (+ popup.x 8.) 163. 158. 30.)
              content (vec4f (+ popup.x 15.) 169. 144. 18.)]
          (round destination (line) 6.)
          (round (vec4f (+ destination.x 1.) (+ destination.y 1.) (- destination.z 2.) (- destination.w 2.)) (paper) 5.)
          (focus-ring destination 309.)
          (print "input") (print destination) (print content)
          (print (vec4f 309. 30. (if (== (input 44u) 309.) 1. 0.) 0.))
          (print (ink 1.)) (print "Link destination") (print "https://…")
          (when (clicked destination) (action 24. 0.))
          (when (and (== event 5.) (== (input 44u) 309.)) (action 24. 1.)))
        (link-button (vec4f (+ popup.x 170.) 163. 39. 30.) (input 46u) 310. 9.)
        (link-button (vec4f (+ popup.x 213.) 163. 59. 30.) (input 47u) 311. 10.))
      (when (> pane-menu 0.)
        (round menu-box (line) 7.)
        (round (vec4f (+ menu-box.x 1.) (+ menu-box.y 1.) (max 1. (- menu-box.z 2.)) (max 1. (- menu-box.w 2.))) (paper) 6.)
        (for [i 0u (< i (u32 (min 8. (input 32u)))) (+= i 1u)]
          (let [row (vec4f (+ menu-box.x 2.) (+ menu-box.y (* (f32 i) 30.)) (max 1. (- menu-box.z 4.)) 30.)]
            (when (== (f32 i) (input 39u)) (round row (hover) 6.))
            (button row 19. (f32 i) enabled)
            (named-control row enabled (+ 240. (f32 i)))
            (slot (vec4f (+ row.x 8.) (+ row.y 9.) (max 1. (- row.z 16.)) 11.) (ink 0.) (+ 240. (f32 i)))))
        (when (and (== event 1.) (not (inside menu-box))) (action 18. 3.)))
      (print "state") (print (vec4f side context focus text-size)))))
