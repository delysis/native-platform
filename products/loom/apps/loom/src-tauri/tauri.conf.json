{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Loom",
  "mainBinaryName": "loom-app",
  "version": "0.1.0",
  "identifier": "app.delysis.loom",
  "build": {
    "beforeDevCommand": "node ../../../../scripts/build-loom-signal.mjs && pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "node ../../../../scripts/build-loom-signal.mjs && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Loom",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "width": 1280,
        "height": 820,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "dragDropEnabled": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' loom-asset: http://loom-asset.localhost data:; media-src 'self' loom-asset: http://loom-asset.localhost blob:; frame-src 'self' loom-preview: http://loom-preview.localhost; style-src 'self'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "externalBin": ["binaries/loom-signal"],
    "resources": {
      "../../../signal/NOTICE.md": "licenses/loom-signal/NOTICE.md",
      "../../../signal/LICENSE.md": "licenses/loom-signal/LICENSE.md",
      "../../../signal/vendor/presage/LICENSE.md": "licenses/loom-signal/presage/LICENSE.md",
      "../../../signal/vendor/presage/UPSTREAM.json": "licenses/loom-signal/presage/UPSTREAM.json",
      "../../../signal/vendor/presage-store-sqlite/LICENSE.md": "licenses/loom-signal/presage-store-sqlite/LICENSE.md",
      "../../../signal/vendor/presage-store-sqlite/UPSTREAM.json": "licenses/loom-signal/presage-store-sqlite/UPSTREAM.json"
    },
    "targets": ["app"],
    "category": "Productivity",
    "shortDescription": "Local-first writing with private model branches",
    "longDescription": "Loom is a local-first writing environment for prose and poetry, with immutable revisions and optional local base-model continuations.",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "Loom.entitlements",
      "infoPlist": "Info.plist"
    }
  }
}
