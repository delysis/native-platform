{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-default",
  "description": "Loom desktop editing capability",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-set-title",
    "core:window:allow-is-fullscreen",
    "core:window:allow-start-dragging",
    "core:menu:allow-new",
    "core:menu:allow-popup",
    "core:resources:allow-close",
    "loom:default",
    "loom:connected-import",
    "loom:local-generation",
    "loom:microphone-capture",
    "loom:verified-model-download",
    "loom:manuscript-promotion"
  ]
}
