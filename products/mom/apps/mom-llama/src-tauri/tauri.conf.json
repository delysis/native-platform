{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blessenger",
  "version": "0.1.0",
  "identifier": "com.delysis.llama-native-kit.mom-llama",
  "build": {
    "beforeBuildCommand": "pnpm run build:qwen-helper",
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Blessenger",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "decorations": true,
        "width": 1440,
        "height": 860,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "useHttpsScheme": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 26
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; img-src 'self' asset: data: blob:; media-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "externalBin": ["binaries/qwen3-tts-helper", "binaries/mlx.metallib"],
    "resources": {
      "resources/speech-voices/qwen-icl/": "speech-voices/qwen-icl/"
    },
    "icon": ["icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "MomLlama.entitlements",
      "infoPlist": "Info.plist"
    }
  }
}
