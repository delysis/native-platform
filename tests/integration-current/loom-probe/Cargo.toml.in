[package]
name = "integration-current-loom-probe"
version = "0.0.0"
edition = "2024"
rust-version = "1.92"
publish = false

[workspace]
resolver = "3"

[dependencies]
loom-backend-llama-current = { package = "loom-backend-llama", git = "https://github.com/delysis/loom-native", rev = "223110bee4be72386d79306b444517371e4a9930" }
loom-campaign-current = { package = "loom-campaign", git = "https://github.com/delysis/loom-native", rev = "223110bee4be72386d79306b444517371e4a9930" }
loom-context-current = { package = "loom-context", git = "https://github.com/delysis/loom-native", rev = "223110bee4be72386d79306b444517371e4a9930" }
loom-eval-codex-current = { package = "loom-eval-codex", git = "https://github.com/delysis/loom-native", rev = "223110bee4be72386d79306b444517371e4a9930" }
loom-learning-current = { package = "loom-learning", git = "https://github.com/delysis/loom-native", rev = "223110bee4be72386d79306b444517371e4a9930" }
platform-contract-testkit-current = { package = "platform-contract-testkit", path = "../../crates/platform/contracts/crates/platform-contract-testkit" }
platform-vertical-fixtures-v0-current = { package = "platform-vertical-fixtures-v0", path = "../../crates/platform/contracts/crates/platform-vertical-fixtures-v0" }

[patch."https://github.com/delysis/w1-platform-contracts"]
platform-contracts-v0 = { path = "../../crates/platform/contracts/crates/platform-contracts-v0" }
platform-contract-testkit = { path = "../../crates/platform/contracts/crates/platform-contract-testkit" }
platform-vertical-fixtures-v0 = { path = "../../crates/platform/contracts/crates/platform-vertical-fixtures-v0" }

[patch."https://github.com/delysis/w1-platform-contracts.git"]
platform-contracts-v0 = { path = "../../crates/platform/contracts/crates/platform-contracts-v0" }
platform-contract-testkit = { path = "../../crates/platform/contracts/crates/platform-contract-testkit" }
platform-vertical-fixtures-v0 = { path = "../../crates/platform/contracts/crates/platform-vertical-fixtures-v0" }

[patch."https://github.com/delysis/llama-native-kit"]
llama-native-cache = { path = "../../crates/native/crates/llama-native-cache" }
llama-native-engine = { path = "../../crates/native/crates/llama-native-engine" }
llama-native-host = { path = "../../crates/native/crates/llama-native-host" }
llama-native-types = { path = "../../crates/native/crates/llama-native-types" }

[patch."https://github.com/delysis/llama-native-kit.git"]
llama-native-cache = { path = "../../crates/native/crates/llama-native-cache" }
llama-native-engine = { path = "../../crates/native/crates/llama-native-engine" }
llama-native-host = { path = "../../crates/native/crates/llama-native-host" }
llama-native-types = { path = "../../crates/native/crates/llama-native-types" }

[lints.rust]
unsafe_code = "forbid"
