{
  "name": "@delysis/native-platform-workspace",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "check": "pnpm install --lockfile-only --frozen-lockfile",
    "fte:test": "pnpm --filter free-token-energy test",
    "loom:test": "pnpm --filter @delysis/loom test",
    "loom:check": "pnpm --filter @delysis/loom check",
    "loom:build": "pnpm --filter @delysis/loom build"
  }
}
