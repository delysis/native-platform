{
  "name": "@delysis/native-platform-workspace",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "check": "pnpm install --lockfile-only --frozen-lockfile",
    "loom:install": "pnpm --dir products/loom install --frozen-lockfile",
    "loom:test": "pnpm --dir products/loom/apps/loom run test",
    "loom:check": "pnpm --dir products/loom/apps/loom run check",
    "loom:build": "pnpm --dir products/loom/apps/loom run build"
  }
}
