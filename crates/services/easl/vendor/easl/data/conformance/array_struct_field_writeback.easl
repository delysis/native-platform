(struct Entry position: vec2f id: u32)
(var entries: [2: Entry])
(var dynamic-entries: [Entry])
(defn bump [@ref @var value: u32] (+= value 3u))
(defn f []: vec4f
  (= (entries 0u) (Entry (vec2f 1. 2.) 4u))
  (= (.id (entries 0u)) 8u)
  (bump (.id (entries 0u)))
  (= (.y (.position (entries 0u))) 9.)
  (= dynamic-entries (zeroed-array 2u))
  (= (dynamic-entries 1u) (Entry (vec2f 3. 4.) 5u))
  (+= (.id (dynamic-entries 1u)) 7u)
  (vec4f (f32 (.id (entries 0u))) (.y (.position (entries 0u)))
         (f32 (.id (dynamic-entries 1u))) (.x (.position (dynamic-entries 1u)))))
