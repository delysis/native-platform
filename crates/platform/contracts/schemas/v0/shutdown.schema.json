{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.delysis.dev/w1/v0/shutdown.schema.json",
  "title": "Delysis closed supervisor summary v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "phase",
    "active_operations",
    "retained_tasks",
    "expected_workers",
    "joined_workers",
    "resources",
    "failures"
  ],
  "properties": {
    "schema": { "const": "delysis.closed_summary.v0" },
    "phase": { "const": "closed" },
    "active_operations": { "const": 0 },
    "retained_tasks": { "const": 0 },
    "expected_workers": { "type": "integer", "minimum": 0 },
    "joined_workers": { "type": "integer", "minimum": 0 },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/resource" }
    },
    "failures": {
      "type": "array",
      "items": { "$ref": "#/$defs/failure" }
    }
  },
  "$defs": {
    "opaque_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "service_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[!#-\\[\\]-~]+$"
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_id",
        "service",
        "kind",
        "state",
        "expected_workers",
        "joined_workers"
      ],
      "properties": {
        "resource_id": { "$ref": "#/$defs/opaque_id" },
        "service": { "$ref": "#/$defs/service_id" },
        "kind": {
          "enum": [
            "operation_registry",
            "task_supervisor",
            "backend",
            "worker_pool",
            "runtime"
          ]
        },
        "state": { "enum": ["stopped", "failed"] },
        "expected_workers": { "type": "integer", "minimum": 0 },
        "joined_workers": { "type": "integer", "minimum": 0 }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failure_id", "resource_id", "service", "error"],
      "properties": {
        "failure_id": { "$ref": "#/$defs/opaque_id" },
        "resource_id": { "$ref": "#/$defs/opaque_id" },
        "service": { "$ref": "#/$defs/service_id" },
        "error": { "$ref": "service-error.schema.json" }
      }
    }
  }
}
