{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.delysis.dev/w1/v0/vertical-observation.schema.json",
  "title": "Delysis vertical observation v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "vertical_id",
    "case_id",
    "implementation_revision",
    "observed_prerequisites",
    "evidence",
    "projection"
  ],
  "properties": {
    "schema": { "const": "delysis.vertical_observation.v0" },
    "vertical_id": { "$ref": "#/$defs/vertical_id" },
    "case_id": { "$ref": "#/$defs/safe_id" },
    "implementation_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "observed_prerequisites": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/prerequisite" }
    },
    "evidence": { "$ref": "https://schemas.delysis.dev/w1/v0/evidence.schema.json" },
    "projection": { "$ref": "#/$defs/projection" }
  },
  "$defs": {
    "vertical_id": {
      "enum": [
        "mom_chat_cancel_retry",
        "mom_attachment",
        "fte_hosted_fixture_loopback",
        "speech_peer_cancellation",
        "information_install_query",
        "loom_suggestion_promotion",
        "loom_research_diagnostic_admitted_distinction",
        "quit_relaunch_fake_owners",
        "current_exact_qwen",
        "current_exact_gemma",
        "current_parakeet_model_audio",
        "apple_installed_voice",
        "mom_prior_release_store",
        "loom_prior_project_store",
        "fte_legacy_database",
        "information_resource_store",
        "corrupted_disposable_caches",
        "partial_publication_states"
      ]
    },
    "safe_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[!#-\\[\\]-~]+$"
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "hex"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest", "length"],
      "properties": {
        "id": { "$ref": "#/$defs/safe_id" },
        "digest": { "$ref": "#/$defs/digest" },
        "length": { "type": "integer", "minimum": 0 }
      }
    },
    "prerequisite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prerequisite_id", "kind", "identity"],
      "properties": {
        "prerequisite_id": { "$ref": "#/$defs/safe_id" },
        "kind": { "enum": ["exact_external_artifact", "platform_inventory", "local_runtime"] },
        "identity": { "$ref": "#/$defs/artifact" }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "operation_id",
        "attempt_id",
        "correlation_id",
        "kind",
        "payload"
      ],
      "properties": {
        "sequence": { "type": "integer", "minimum": 0 },
        "operation_id": { "$ref": "#/$defs/safe_id" },
        "attempt_id": {
          "oneOf": [{ "$ref": "#/$defs/safe_id" }, { "type": "null" }]
        },
        "correlation_id": {
          "oneOf": [{ "$ref": "#/$defs/safe_id" }, { "type": "null" }]
        },
        "kind": { "$ref": "#/$defs/safe_id" },
        "payload": {
          "oneOf": [{ "$ref": "#/$defs/artifact" }, { "type": "null" }]
        }
      }
    },
    "durable_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_id", "schema_id", "before", "after", "disposition"],
      "properties": {
        "state_id": { "$ref": "#/$defs/safe_id" },
        "schema_id": { "$ref": "#/$defs/safe_id" },
        "before": {
          "oneOf": [{ "$ref": "#/$defs/artifact" }, { "type": "null" }]
        },
        "after": {
          "oneOf": [{ "$ref": "#/$defs/artifact" }, { "type": "null" }]
        },
        "disposition": {
          "enum": ["unchanged", "created", "updated", "removed", "quarantined", "recovered"]
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "attempt_id", "correlation_id", "terminal", "released"],
      "properties": {
        "operation_id": { "$ref": "#/$defs/safe_id" },
        "attempt_id": {
          "oneOf": [{ "$ref": "#/$defs/safe_id" }, { "type": "null" }]
        },
        "correlation_id": {
          "oneOf": [{ "$ref": "#/$defs/safe_id" }, { "type": "null" }]
        },
        "terminal": { "enum": ["completed", "cancelled", "failed"] },
        "released": { "const": true }
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active_operations", "retained_tasks", "expected_workers", "joined_workers"],
      "properties": {
        "active_operations": { "const": 0 },
        "retained_tasks": { "const": 0 },
        "expected_workers": { "type": "integer", "minimum": 0 },
        "joined_workers": { "type": "integer", "minimum": 0 }
      }
    },
    "fact": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "boolean" },
            "value": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "integer" },
            "value": { "type": "integer" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "text" },
            "value": { "type": "string", "minLength": 1, "maxLength": 4096 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "digest" },
            "value": { "$ref": "#/$defs/digest" }
          }
        }
      ]
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordered_events",
        "durable_state",
        "lifecycle",
        "ownership",
        "output_facts",
        "fail_closed_facts"
      ],
      "properties": {
        "ordered_events": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/event" }
        },
        "durable_state": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/durable_state" }
        },
        "lifecycle": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/lifecycle" }
        },
        "ownership": { "$ref": "#/$defs/ownership" },
        "output_facts": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/safe_id" },
          "additionalProperties": { "$ref": "#/$defs/fact" }
        },
        "fail_closed_facts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
        }
      }
    }
  }
}
