* text=auto

*.json text eol=lf
*.commit-map text eol=lf
*.lock text eol=lf
*.md text eol=lf
*.rs text eol=lf
*.sh text eol=lf
*.toml text eol=lf
*.toml.in text eol=lf
*.tsv text eol=lf
*.rs.in text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Pinned upstream bytes must survive checkout unchanged on every platform.
third-party/omp2/upstream/** -text
# Git patch context contains space-only lines; prepare checks applied whitespace.
third-party/omp2/patches/** -text -whitespace
# SSE's final empty line is a protocol delimiter, not stray whitespace.
third-party/omp2/upstream/**/*.sse whitespace=-blank-at-eof
